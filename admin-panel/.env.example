# Google OAuth Web client ID, from Google Cloud Console → Credentials.
# This must be the SAME Web client ID the backend lists in GOOGLE_WEB_CLIENT_ID,
# and this origin must appear under the client's "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Origin of the DeenQuest API. Leave empty for local development — vite
# proxies /api to localhost:8080. Set it for deployed builds, where the panel
# is served from a different origin than the API:
#   VITE_API_BASE_URL=https://api.deenquest.app
VITE_API_BASE_URL=
