[Unit]
Description=Decrypt DeenQuest production config to tmpfs
Before=docker.service
DefaultDependencies=no
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# /run is a tmpfs, so the decrypted config never touches disk and does not
# survive a reboot — it is re-derived from the encrypted file in git each boot.
# root:deploy, 0750/0440 — the deploy user needs to read this to hand it to
# docker compose, and nothing more. It never gets the age key, so a compromised
# deploy key yields the running config but no ability to decrypt anything else.
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g deploy /run/deenquest
ExecStart=/bin/bash -c 'SOPS_AGE_KEY_FILE=/etc/deenquest/age.key /usr/local/bin/sops -d /srv/deenquest/deploy/secrets/prod.enc.env > /run/deenquest/prod.env'
ExecStartPost=/bin/chown root:deploy /run/deenquest/prod.env
ExecStartPost=/bin/chmod 0440 /run/deenquest/prod.env

[Install]
WantedBy=multi-user.target
