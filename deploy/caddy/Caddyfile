# Internal reverse proxy. TLS is terminated by Cloudflare, so this speaks plain
# HTTP on a private Docker network and never faces the internet.
{
	# The admin API must stay on: `caddy reload` is what performs the blue/green
	# switch, and it works only through this endpoint. It binds to localhost
	# inside the container's own network namespace and no port is published, so
	# it is unreachable from the host, from other containers, and from the
	# internet — turning it off cost nothing and broke every deploy.
	admin localhost:2019
	auto_https off
	servers {
		# Caddy is the only thing cloudflared talks to, and cloudflared is the
		# only thing that talks to Caddy.
		trusted_proxies static 172.16.0.0/12
	}
}

:80 {
	# /metrics is for Alloy, which scrapes the container directly over the internal
	# Docker network. From the public side it is a map of every route template and
	# status code the API serves, so it is not served here at all.
	@metrics path /metrics
	respond @metrics 404

	# The blue/green switch. deploy.sh rewrites this one file and reloads.
	import /etc/caddy/active.conf

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Keep health probes out of the access log; they are every 10 seconds.
	log {
		output stdout
		format json
	}
}
