# Template for the encrypted production environment.
#
#   cp deploy/secrets/prod.env.example /tmp/prod.env
#   $EDITOR /tmp/prod.env                       # fill in real values
#   sops -e /tmp/prod.env > deploy/secrets/prod.enc.env
#   shred -u /tmp/prod.env
#
# The encrypted file is committed. This template never holds a real value.
# Generate secrets with:  openssl rand -base64 48   /   openssl rand -hex 32

APP_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ── data ──────────────────────────────────────────────────────────────────────
# dq_app has readWrite on the deenquest database and nothing else. It cannot
# drop the database, create users, or reach any other database.
MONGO_URI=mongodb://dq_app:REPLACE@mongo:27017/deenquest?authSource=admin&tls=true&tlsCAFile=/etc/mongo/tls/ca.pem&replicaSet=rs0
MONGO_DB=deenquest
MONGO_ROOT_USER=dq_root
MONGO_ROOT_PASSWORD=REPLACE
MONGO_APP_PASSWORD=REPLACE
MONGO_BACKUP_PASSWORD=REPLACE

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE
REDIS_DB=0

# ── auth ──────────────────────────────────────────────────────────────────────
# Rotating this invalidates access tokens for up to 15 minutes but does NOT log
# anyone out: refresh tokens are hashed in MongoDB and validated by lookup.
JWT_SECRET=REPLACE
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=1440h

# The only path to the ADMIN role. Empty means every signed-in user is an admin,
# so the API refuses to start in production without it.
ADMIN_EMAILS=you@yourdomain.com

GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_CLIENT_IDS=com.awaisrasool.DeenQuestExpo

# ── network ───────────────────────────────────────────────────────────────────
# Exact production origins only. localhost or a wildcard here fails startup.
CORS_ALLOWED_ORIGINS=https://admin.deenquest.app,https://deenquest.app

# The Docker bridge — the only proxy allowed to set forwarding headers.
TRUSTED_PROXIES=172.16.0.0/12

# ── internal services ─────────────────────────────────────────────────────────
WHISPER_URL=http://whisper:8001
WHISPER_INTERNAL_TOKEN=REPLACE

# ── third parties ─────────────────────────────────────────────────────────────
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
COACH_ENABLED=true
COACH_LLM_ENABLED=false
ALQURAN_BASE_URL=https://api.alquran.cloud/v1
QURAN_AUDIO_CDN_URL=https://cdn.islamic.network
QURAN_AUDIO_EDITION=ar.alafasy
QURAN_AUDIO_BITRATE=128

# ── infrastructure (read by compose, not by the API) ──────────────────────────
CF_TUNNEL_TOKEN=REPLACE
GHCR_OWNER=m-awais-rasool

GRAFANA_PROM_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
GRAFANA_PROM_USER=REPLACE
GRAFANA_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=REPLACE
GRAFANA_CLOUD_TOKEN=REPLACE

# Backups. AGE_PUBLIC_KEY encrypts them; the matching private key is NOT on this
# host, so a compromised box cannot read its own backup history.
AGE_PUBLIC_KEY=age1REPLACE
HC_UUID=REPLACE
