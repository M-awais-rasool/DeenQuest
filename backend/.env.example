APP_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

MONGO_URI=
MONGO_DB=deenquest

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=1440h

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

WHISPER_URL=http://localhost:8001
# Shared secret sent as X-Internal-Token on every whisper call. The whisper
# service has no other authentication. Required in production.
#   openssl rand -hex 32
WHISPER_INTERNAL_TOKEN=

# Comma-separated CIDRs allowed to set X-Forwarded-For. Empty = trust nobody,
# which is correct for local development. In production set it to the reverse
# proxy's network (e.g. 172.16.0.0/12 for the Docker bridge); leaving it empty
# lets any client forge its own IP and walk past the rate limiter.
TRUSTED_PROXIES=

ALQURAN_BASE_URL=https://api.alquran.cloud/v1
QURAN_AUDIO_CDN_URL=https://cdn.islamic.network
QURAN_AUDIO_EDITION=ar.alafasy
QURAN_AUDIO_BITRATE=128

EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

OLLAMA_URL=http://127.0.0.1:11434

# Learning Agent — optional Gemini AI feedback/motivation layer.
# Leave GEMINI_API_KEY empty to run the learning core fully deterministic
# (the AI consumer simply isn't started). GEMINI_MODEL is optional; defaults
# to gemini-2.0-flash (fast + cheap for short copy).

GEMINI_API_KEY=
GEMINI_MODEL=

# AI Coach kill switches. COACH_ENABLED gates the whole module (telemetry
# ingest, insights, practice, nightly sweep). COACH_LLM_ENABLED additionally
# lets Gemini rephrase insight copy (cached, 800ms budget, <=3 calls/user/day);
# off = 100% template-driven. The coach works fully without any LLM.
COACH_ENABLED=true
COACH_LLM_ENABLED=false

# Sign in with Google. Client IDs come from Google Cloud Console →
# Credentials. They are not secrets — they ship inside the app binary — but
# every one listed here becomes an accepted token audience, so list only ours.
# The Web client ID is required even for Android: it is what mints the ID token.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=


# Sign in with Apple — comma-separated bundle IDs / service IDs.
APPLE_CLIENT_IDS=com.awaisrasool.DeenQuestExpo

# Admin access. There is no admin account to seed: whoever signs in with a
# listed address through any provider is granted the ADMIN role, and losing the
# listing drops it again. This is the only path to ADMIN.
# Comma-separated. Empty = every signed-in user can reach /admin (dev only).
ADMIN_EMAILS=you@yourdomain.com
