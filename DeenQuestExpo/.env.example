# Copy this file to .env and fill in the values from
# Google Cloud Console → APIs & Services → Clients.
#
# These are not secrets — they ship inside the app binary and anyone can read
# them out of an APK. They live outside the repo so a public repo does not
# advertise the project, and so this file never becomes the place someone drops
# a real secret. The Web client's *secret* is never used and must not go here.
#
# The Web client ID is required on Android too: it is what mints the ID token.
# Android's own client ID never appears in the app — Google matches it by
# package name and SHA-1 fingerprint.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# EAS cloud builds do not upload .env. Register the same values once with:
#   eas secret:create --scope project --name GOOGLE_WEB_CLIENT_ID --value "..."
#   eas secret:create --scope project --name GOOGLE_IOS_CLIENT_ID --value "..."
