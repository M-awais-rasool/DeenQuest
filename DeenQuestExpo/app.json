{
  "expo": {
    "name": "Deen Quest",
    "slug": "deenquestexpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "deenquest",
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/adhan_notification.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DeenQuest uses your location to calculate accurate prayer times.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1517"
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.awaisrasool.DeenQuestExpo",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.awaisrasool.DeenQuestExpo"
    },
    "web": {
      "favicon": "./assets/logo/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "e7b64664-fdf0-4e44-8a22-69c519ec7417"
      }
    },
    "owner": "awais-rasool"
  }
}
